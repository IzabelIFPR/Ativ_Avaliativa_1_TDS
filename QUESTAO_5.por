programa
{
	
	funcao inicio()
	{
		real temperatura
		
		escreva("Fala uma temperatura ai mano ")
		leia(temperatura)
		
		se (temperatura <= 0){
			escreva("A temperatura ta negativa")
		} senao {
			escreva("A temperatura ta positiva")
		}
	}
}
